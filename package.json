{
  "name": "gokai-music-project",
  "version": "1.0.0",
  "description": "A 1:1 functional clone of Jockie Music for Discord — prefix-only, component-driven UI, Lavalink v4 audio engine.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "deploy": "npm ci && npx prisma db push && npm run build && pm2 startOrReload ecosystem.config.js && pm2 save",
    "pm2:start": "pm2 start ecosystem.config.js && pm2 save",
    "pm2:restart": "pm2 restart gokai-music",
    "pm2:stop": "pm2 stop gokai-music",
    "pm2:logs": "pm2 logs gokai-music",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "discord.js",
    "music",
    "jockie",
    "lavalink",
    "kazagumo",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "kazagumo": "^3.2.0",
    "shoukaku": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
