# ─────────────────────────────────────────────────────────────────────────────
#  Docker Compose secrets. Copy to `.env` next to docker-compose.yml.
#    cp .env.docker.example .env
#  NOTE: docker compose reads this `.env` automatically for ${VAR} substitution.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=000000000000000000
BOT_OWNER_IDS=000000000000000000
DEFAULT_PREFIX=m!

# ── PostgreSQL (used by the postgres service AND the bot's DATABASE_URL) ──────
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Lavalink ─────────────────────────────────────────────────────────────────
# This password is injected into Lavalink AND the bot's node config — keep them
# identical. It overrides whatever is in application.yml.
LAVALINK_PASSWORD=change-me-too
# JVM heap for the Lavalink container (e.g. 512M, 1G, 2G).
LAVALINK_HEAP=1G
