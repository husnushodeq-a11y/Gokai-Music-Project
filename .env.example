# ─────────────────────────────────────────────────────────────
#  Gokai Music — Environment Configuration
# ─────────────────────────────────────────────────────────────

# Discord bot token (from the Developer Portal).
DISCORD_TOKEN=your-bot-token-here

# The application (client) id of the bot user.
DISCORD_CLIENT_ID=000000000000000000

# The DEFAULT command prefix used when neither the user nor the
# guild has overridden it. Jockie's canonical default is "m!".
DEFAULT_PREFIX=m!

# Comma-separated list of bot owner ids (full admin, bypass all checks).
BOT_OWNER_IDS=000000000000000000

# ── PostgreSQL / Prisma ──────────────────────────────────────
# Standard Prisma connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/gokai_music?schema=public

# ── Lavalink (v4) nodes ──────────────────────────────────────
# A JSON array of node descriptors consumed by the AudioManager.
# Each node: { "name", "url" (host:port), "auth" (password), "secure" }.
LAVALINK_NODES=[{"name":"main","url":"localhost:2333","auth":"youshallnotpass","secure":false}]
